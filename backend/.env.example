# 이 파일을 .env 로 복사해 값을 채웁니다. 복사한 .env 는 git 에 올라가지 않습니다.
#
# 따옴표를 붙이지 않습니다. properties 로 읽혀 따옴표가 값에 들어갑니다.

# ── 필수 ────────────────────────────────────────────────────────────
# 비어 있으면 서버가 뜨지 않습니다. 기본값이 없습니다.
DB_PASSWORD=

# ── 선택: API 키 저장 ───────────────────────────────────────────────
# 설정 화면에서 넣은 API 키를 DB 에 암호화해 저장할 때 쓰는 마스터 키입니다.
# 길이는 자유입니다. SHA-256 으로 256비트 키를 만듭니다.
# 비워 두면 앱은 뜨지만 설정 화면의 키 저장만 막힙니다.
# 한 번 정하면 바꾸지 않습니다. 바꾸면 저장해 둔 키를 읽지 못합니다.
LONELYTRACKER_ENCRYPTION_KEY=

# ── 선택: DB 주소 ───────────────────────────────────────────────────
# 아래 기본값과 다를 때만 적습니다. 둘은 함께 적습니다.
# 무료 호스팅의 주소 형식과 함정은 INSTALL.md 에 있습니다.
# DB_URL=jdbc:postgresql://localhost:5432/lonelytracker
# DB_USERNAME=lonelytracker

# ── 선택: AI 제공자 ────────────────────────────────────────────────
# 제공자 하나를 .env 로 고정하는 길입니다. 설정 화면에서 고른 것이 이보다 먼저입니다.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash
# AI_API_KEY=
