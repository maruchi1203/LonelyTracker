# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. .env 는 git에 올라가지 않습니다.
#
# application.yml 이 optional:file:.env[.properties] 로 읽어들이므로
# 파일이 없어도 앱은 뜹니다. 배포 환경에서는 .env 없이 실제 환경변수를 씁니다.

# PostgreSQL 접속 정보
DB_URL=jdbc:postgresql://localhost:5432/lonelytracker
DB_USERNAME=lonelytracker
DB_PASSWORD=

# 자연어 파싱(POST /api/schedules/parse)에 쓰입니다.
# 비워두면 앱은 정상 기동하고 파싱 요청에만 503 이 나갑니다.
# AI 없이도 일정 CRUD 는 되므로 기동을 막지 않습니다.
OPENAI_API_KEY=
